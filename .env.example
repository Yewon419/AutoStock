# ── PostgreSQL ─────────────────────────────────────────────
POSTGRES_USER=autostock
POSTGRES_PASSWORD=autostock123
POSTGRES_DB=autostock

# ── Backend ────────────────────────────────────────────────
DATABASE_URL=postgresql://autostock:autostock123@postgres:5432/autostock
REDIS_URL=redis://redis:6379

# ── 보안 (반드시 교체할 것) ───────────────────────────────
# 생성: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-in-production

# Fernet 키 생성: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ── 브로커 ─────────────────────────────────────────────────
# mock | paper | real
BROKER_MODE=paper

# ── KIS (한국투자증권) ───────────────────────────────────────
# KIS Developers (https://apiportal.koreainvestment.com) 에서 발급
KIS_APP_KEY=your_app_key
KIS_APP_SECRET=your_app_secret
KIS_ACCOUNT_NO=12345678-01   # 모의투자 계좌번호
KIS_IS_PAPER=true            # true=모의투자, false=실계좌

# ── CORS ───────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
